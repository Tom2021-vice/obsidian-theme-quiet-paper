{
  "name": "quiet-paper",
  "version": "0.1.8",
  "private": true,
  "description": "A paper-like Obsidian theme inspired by Telari typography.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "stylelint \"src/**/*.css\"",
    "check": "npm run build && npm run lint",
    "test:spacing": "node tests/spacing.mjs",
    "test:appearance": "node tests/appearance.mjs",
    "test": "npm run test:spacing && npm run test:appearance && npm run test:typography && npm run test:quote-print && npm run test:build",
    "test:typography": "node tests/typography.mjs",
    "test:quote-print": "node tests/quote-print.mjs",
    "check:community": "node scripts/check-community.mjs",
    "test:build": "node tests/build.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.63.0",
    "stylelint": "17.15.0",
    "stylelint-config-obsidianmd": "0.1.0",
    "postcss": "8.5.28"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tom2021-vice/obsidian-theme-quiet-paper.git"
  },
  "homepage": "https://github.com/Tom2021-vice/obsidian-theme-quiet-paper#readme",
  "bugs": {
    "url": "https://github.com/Tom2021-vice/obsidian-theme-quiet-paper/issues"
  }
}
